# ═══════════════════════════════════════════════════════════════
#  Образ бота.
#
#  python:3.12-slim — официальный образ с Python и минимумом системы.
#  Полный python:3.12 весит ~1 ГБ против ~130 МБ у slim, а разница —
#  компиляторы и утилиты, которые нам не нужны: все наши зависимости
#  ставятся готовыми колёсами.
#
#  Alpine ещё меньше, но там другая стандартная библиотека C (musl),
#  из-за чего часть пакетов приходится компилировать — сборка дольше,
#  а выигрыш в размере съедается.
# ═══════════════════════════════════════════════════════════════
FROM python:3.12-slim

# PYTHONDONTWRITEBYTECODE — не создавать .pyc: в контейнере они
#   бесполезны и только раздувают слой.
# PYTHONUNBUFFERED — не буферизовать вывод, иначе логи появляются
#   в `docker logs` пачками с задержкой, что мучительно при отладке.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Зависимости ставим ДО копирования кода — и это не косметика.
# Docker кеширует каждый шаг: пока requirements.txt не менялся, слой
# с установкой берётся из кеша. Правка кода пересобирает образ
# за секунды, а не за минуты.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Код копируем отдельно и только нужное. Тесты, .git и виртуальное
# окружение в образ не попадают (см. .dockerignore).
COPY bot/ ./bot/
COPY scripts/ ./scripts/

# Папки под данные и логи. Их содержимое приедет из volume'ов,
# но каталоги должны существовать и быть доступны на запись.
RUN mkdir -p /app/data /app/logs

# Непривилегированный пользователь. По умолчанию контейнер работает
# от root, и если злоумышленник найдёт дыру в приложении, он получит
# root внутри контейнера — а это уже заметно ближе к хосту.
# Боту права суперпользователя не нужны ни для чего.
RUN useradd --create-home --uid 1000 botuser \
    && chown -R botuser:botuser /app
USER botuser

# Запуск модулем, а не файлом: так работают относительные импорты
# внутри пакета bot.
CMD ["python", "-m", "bot.main"]
