# ═══════════════════════════════════════════════════════════════
#  ШАБЛОН переменных окружения.
#
#  Этот файл КОММИТИТСЯ в git — он не содержит значений, только имена.
#  Реальные значения живут в файле .env, который в .gitignore.
#
#  Как пользоваться:  скопируй этот файл в .env и заполни значения.
#     Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────
# Токен бота. Выдаёт @BotFather в Telegram (сделаем в Фазе 1).
# Выглядит так: 1234567890:AAF9k2...
BOT_TOKEN=

# ID чата администраторов, куда бот присылает новые заявки.
# У групповых чатов ID отрицательный, например: -1001234567890
# Как его узнать — разберём в Фазе 7.
ADMIN_CHAT_ID=

# ── Google Sheets (понадобится в Фазе 6) ───────────────────────
# Путь к JSON-ключу сервисного аккаунта Google.
GOOGLE_CREDENTIALS_FILE=secrets/google-credentials.json

# ID таблицы — это кусок её URL между /d/ и /edit
# https://docs.google.com/spreadsheets/d/ЭТОТ_КУСОК/edit
GOOGLE_SHEET_ID=

# ── Приложение ─────────────────────────────────────────────────
# Файл локальной базы SQLite (Фаза 5).
DATABASE_PATH=data/orders.db

# Путь к YAML-конфигу с направлениями обучения (Фаза 2).
CATALOG_PATH=config/school.yaml

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
