# ─────────────────────────────────────────────────────────────
#  СЕКРЕТЫ — самое важное. Ничего из этого не должно попасть в git.
# ─────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*credentials*.json

# Папку secrets/ оставляем в репозитории (нужна при клонировании),
# но всё её содержимое игнорируем. Строка с «!» — это исключение
# из правила выше: .gitkeep попадёт в git, остальное — никогда.
secrets/*
!secrets/.gitkeep

# ─────────────────────────────────────────────────────────────
#  Данные приложения (у каждого запуска свои, в репозитории не нужны)
# ─────────────────────────────────────────────────────────────
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
logs/*
!logs/.gitkeep

# ─────────────────────────────────────────────────────────────
#  Виртуальное окружение и артефакты Python
# ─────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
#  Мусор редакторов и ОС
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
